# What a clone an older build made its CFO home holds, and what an install
# that keeps such a home adds to it; cfo home move takes it to the per-user
# home, and a clone is source only after that.
projects/
/state/
/bin/
/worktrees/
/scratch/
# Fleet data is local state, except the standing routing policy, which ships.
/data/*
!/data/routing.json
# The shared package-cache root every goblin builds against.
/caches/
.no-mistakes/
.lavish/
.DS_Store
__pycache__/
*.pyc
.env
config/
!/config/
/config/*
!/config/pipeline.json
!/config/verify.json
!/config/voice.json
/cfo.exe
# A go build in the clone, and what an older install.cmd -Dev built there:
# both names and the desktop window, and a copy still running moved aside.
/goblins.exe
# The desktop window built in the clone, and the picture of its notifications,
# which it writes beside itself at each start.
/goblins-window.exe
/goblins-window.png
/cfo.exe.new
/goblins-window.exe.new
/cfo.exe.*.old
/goblins.exe.*.old
/goblins-window.exe.*.old
/frontend/node_modules/
# The board npm run build writes for cfo.exe to embed. The placeholder page a
# build without it serves is the one file under dist that is committed.
/internal/boardweb/dist/*
!/internal/boardweb/dist/index.html
/frontend/test-results/
/frontend/test-results-*.txt
/frontend/playwright.scratch.config.ts

# The skill junctions an older install.cmd -Dev made in the clone (pointing
# at .agents/skills); the skills now install once into ~/.agents/skills.
/.claude/skills/
/.codex/skills/
# Machine-local Claude permissions; never publish them.
/.claude/settings.json

# Where an older build put goblin worktrees; they now live in the CFO home.
.worktrees/
