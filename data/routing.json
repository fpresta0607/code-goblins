{
  "rules": [
    {
      "fault": "auth",
      "switch": {
        "harness": "claude"
      },
      "note": "check project authentication before switching a rejected credential"
    }
  ],
  "default_lane": "build",
  "escalate_to": "deep",
  "start_floor_percent": 10,
  "subagents": {
    "codex": {
      "search": ["mechanical"],
      "review": ["deep"],
      "verify": ["verification", "deep"]
    },
    "claude": {
      "search": ["small-claude"],
      "review": ["strong-claude"],
      "verify": ["verify-claude", "strong-claude"]
    }
  },
  "fallbacks": {
    "build": ["strong-claude"],
    "deep": ["strong-claude"],
    "mechanical": ["small-claude"],
    "scout": ["small-claude"],
    "verification": ["deep", "strong-claude"]
  },
  "lanes": {
    "deep": {
      "harness": "codex",
      "model": "gpt-6-astra",
      "effort": "xhigh",
      "note": "architecture, security, migration, rescue, anything high risk"
    },
    "build": {
      "harness": "codex",
      "model": "gpt-6-astra",
      "effort": "xhigh",
      "note": "ordinary implementation"
    },
    "mechanical": {
      "harness": "codex",
      "model": "gpt-6-luna",
      "effort": "medium",
      "note": "renames, config edits, docs, tightly specified changes"
    },
    "scout": {
      "harness": "codex",
      "model": "gpt-6-luna",
      "effort": "medium",
      "note": "search, read and summarize"
    },
    "strong-claude": {
      "harness": "claude",
      "model": "claude-opus-5-5",
      "effort": "xhigh",
      "note": "strong cross-harness fallback"
    },
    "small-claude": {
      "harness": "claude",
      "model": "haiku",
      "effort": "medium",
      "note": "narrow cross-harness fallback"
    },
    "verification": {
      "harness": "codex",
      "model": "gpt-6-sol",
      "effort": "high",
      "note": "independent verification"
    },
    "verify-claude": {
      "harness": "claude",
      "model": "sonnet",
      "effort": "high",
      "note": "independent verification"
    }
  }
}
